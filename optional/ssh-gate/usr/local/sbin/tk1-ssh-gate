#!/bin/sh
# Once the default user's password is no longer expired, remove every
# part of the SSH lockout, including this script, and start SSH. An
# expired password has 0 as its last-changed date in /etc/shadow.
set -eu
user=$(cat /etc/tk1/default-user)
lastchg=$(getent shadow "$user" | cut -d: -f3)
if [ -z "$lastchg" ] || [ "$lastchg" = 0 ]; then
	exit 0
fi
systemctl disable --now tk1-ssh-gate.path
rm -f /etc/systemd/system/ssh.service.d/tk1-gate.conf \
	/etc/systemd/system/tk1-ssh-gate.path \
	/etc/systemd/system/tk1-ssh-gate.service \
	/etc/issue.d/tk1-ssh-gate.issue \
	/etc/tk1/default-user
rmdir --ignore-fail-on-non-empty /etc/systemd/system/ssh.service.d
systemctl daemon-reload
systemctl start ssh.service
rm -f "$0"
